<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>HostelManagement</RootNamespace>
    <AssemblyName>HostelManagement</AssemblyName>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationVisualStyles>true</ApplicationVisualStyles>
    <ApplicationDefaultFont>Segoe UI, 9.75pt</ApplicationDefaultFont>

    <!--
      The Microsoft Access Database Engine (ACE OLE DB provider) must have the same
      bitness as this process. x64 matches 64 bit Office / the 64 bit Access Database
      Engine redistributable. Switch both to x86 if the target PC uses 32 bit Office.
    -->
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>

    <Product>Hostel Management System</Product>
    <Company>OffbeatSoftwaresolutions</Company>
    <Authors>OffbeatSoftwaresolutions</Authors>
    <Copyright>© OffbeatSoftwaresolutions</Copyright>
    <Version>1.0.0</Version>
    <ApplicationIcon>Resources\AppIcon.ico</ApplicationIcon>

    <!-- Allows the project to be compiled on non Windows build machines (CI). -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="System.Data.OleDb" Version="8.0.1" />
    <!-- PDF invoices (MIT licence). -->
    <PackageReference Include="PDFsharp" Version="6.2.4" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Empty database (all tables, no data). It is copied to the output folder only when no
      database exists there yet, so building never overwrites the database the application uses.
    -->
    <None Update="Database\HostelManagement.accdb" CopyToOutputDirectory="Never" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="CopyEmptyDatabaseIfMissing" AfterTargets="Build" Condition="Exists('Database\HostelManagement.accdb') And !Exists('$(OutDir)Database\HostelManagement.accdb')">
    <Copy SourceFiles="Database\HostelManagement.accdb" DestinationFolder="$(OutDir)Database" />
  </Target>

  <ItemGroup>
    <!-- Photo shown behind the sign in box; built into the program so it cannot go missing. -->
    <EmbeddedResource Include="Resources\LoginBackground.jpg" LogicalName="HostelManagement.LoginBackground.jpg" />
    <EmbeddedResource Include="Resources\AppIcon.ico" LogicalName="HostelManagement.AppIcon.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- The user guide, opened from Application Settings and installed next to the program. -->
    <None Include="..\docs\UserGuide.pdf" Link="UserGuide.pdf" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="Exists('..\docs\UserGuide.pdf')" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="HostelManagement.Tests" />
  </ItemGroup>


</Project>
